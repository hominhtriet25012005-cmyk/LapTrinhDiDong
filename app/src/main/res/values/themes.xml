<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Demo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_soft</item>

        <!-- Surfaces and Backgrounds -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_2_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_light</item>

        <!-- Status bar styling -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Component Shape Styles -->
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.CornerMedium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.CornerLarge</item>
    </style>

    <style name="Theme.Demo" parent="Base.Theme.Demo" />

    <!-- Corner Shape Appearances -->
    <style name="ShapeAppearance.App.CornerMedium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.App.CornerLarge" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Custom Card Style -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Elevated Card Style -->
    <style name="Widget.App.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Hero Blue Card Style -->
    <style name="Widget.App.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/primary</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>